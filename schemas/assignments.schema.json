{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nikos.tools/schemas/assignments.schema.json",
  "title": "nikOS map assignments",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "team",
      "repo"
    ],
    "additionalProperties": false,
    "properties": {
      "team": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "repo": {
        "type": "string",
        "pattern": "^(\\.|[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)+)$"
      },
      "url": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300,
        "pattern": "^\\S+$"
      },
      "ref": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[^\\s]+$"
      },
      "releases": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "integer",
          "minimum": 1
        }
      },
      "activities": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      },
      "stories": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{0,9}(-[A-Z][A-Z0-9]{0,9})?-[0-9]+$"
        }
      }
    },
    "not": {
      "anyOf": [
        {
          "required": [
            "releases",
            "activities"
          ]
        },
        {
          "required": [
            "releases",
            "stories"
          ]
        },
        {
          "required": [
            "activities",
            "stories"
          ]
        }
      ]
    }
  }
}
