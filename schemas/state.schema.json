{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nikos.tools/schemas/state.schema.json",
  "title": "nikOS state",
  "type": "object",
  "required": ["format_version", "stories"],
  "additionalProperties": false,
  "properties": {
    "format_version": { "const": 1 },
    "stories": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9]{0,9}-[0-9]+$" },
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "additionalProperties": false,
        "properties": {
          "status": { "enum": ["todo", "in_progress", "needs_rework", "done", "cancelled"] },
          "claimed_by": { "type": "string" },
          "plan_version": { "type": "integer", "minimum": 1 },
          "blockers": { "type": "array", "items": { "type": "string" } },
          "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "spec_hash": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
          "done_at": { "type": "string", "minLength": 1 },
          "cancelled_reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "queue": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
