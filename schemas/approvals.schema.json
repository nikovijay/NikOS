{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nikos.tools/schemas/approvals.schema.json",
  "title": "nikOS approvals",
  "type": "object",
  "required": ["format_version", "approvals"],
  "additionalProperties": false,
  "properties": {
    "format_version": { "const": 1 },
    "approvals": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9]{0,9}-[0-9]+$" },
      "additionalProperties": {
        "type": "object",
        "required": ["by", "on", "spec_hash", "done_at"],
        "additionalProperties": false,
        "properties": {
          "by": { "type": "string", "minLength": 1 },
          "on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "via": { "enum": ["terminal", "chat", "app", "tracker"] },
          "spec_hash": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
          "done_at": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
