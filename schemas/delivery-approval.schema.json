{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nikos.tools/schemas/delivery-approval.schema.json",
  "title": "nikOS delivery approval",
  "type": "object",
  "required": ["by", "on", "spec_hash", "done_at", "tested_commit"],
  "additionalProperties": false,
  "properties": {
    "by": { "type": "string", "minLength": 1 },
    "on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "via": { "enum": ["terminal", "chat", "app", "tracker"] },
    "spec_hash": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
    "done_at": { "type": "string", "minLength": 1 },
    "tested_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
  }
}
