{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nikos.tools/schemas/planning/bet.schema.json",
  "title": "nikOS Planning bet card front matter",
  "type": "object",
  "required": ["id", "owner", "hypothesis", "krs", "review_on", "confidence", "dependencies", "outcome", "reviews"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "owner": { "type": "string", "minLength": 1 },
    "team": { "type": "string", "minLength": 1 },
    "hypothesis": { "type": "string", "minLength": 1 },
    "krs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": { "type": "string", "minLength": 1 },
        "also": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "starts": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "review_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "deadline": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "confidence": { "enum": ["low", "medium", "high"] },
    "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "outcome": { "enum": ["open", "awaiting evidence", "won", "lost", "stopped"] },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "decision", "reason"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "decision": { "enum": ["continue", "change", "stop", "complete"] },
          "reason": { "type": "string", "minLength": 1 },
          "outcome": { "enum": ["won", "lost", "stopped"] }
        }
      }
    }
  }
}
