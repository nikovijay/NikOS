{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nikos.tools/schemas/planning/kr.schema.json",
  "title": "nikOS Planning key result",
  "type": "object",
  "required": ["id", "title", "owner", "by", "checkins"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "unit": { "type": "string" },
    "kind": { "enum": ["number", "milestone"], "description": "number (the default) is a figure with a baseline and a target. milestone is a list of named steps with done dates." },
    "direction": { "enum": ["up", "down"], "description": "Which way the figure should move. Absent means up." },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "A milestone's steps, in order. Only a milestone has them.",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "done": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    },
    "baseline": { "type": "number" },
    "target": { "type": "number" },
    "original_target": { "type": "number" },
    "by": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "period": { "type": "string", "pattern": "^[0-9]{4}(-Q[1-4])?$", "description": "In a planning repo: the year of a company key result (2027), or the quarter of a department's (2027-Q1)." },
    "aligns_to": { "oneOf": [{ "type": "string", "pattern": "^(?:(?!\\.{1,2}(?:\\/|#|$))[A-Za-z0-9_.-]+(?:\\/(?!\\.{1,2}(?:\\/|#|$))[A-Za-z0-9_.-]+)+#)?[a-z0-9]+(-[a-z0-9]+)*$" }, { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(?:(?!\\.{1,2}(?:\\/|#|$))[A-Za-z0-9_.-]+(?:\\/(?!\\.{1,2}(?:\\/|#|$))[A-Za-z0-9_.-]+)+#)?[a-z0-9]+(-[a-z0-9]+)*$" } }] },
    "stale_after_days": { "type": "integer", "minimum": 1 },
    "checkins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "value"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "value": { "type": "number" },
          "note": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["kind"], "properties": { "kind": { "const": "milestone" } } },
      "then": {
        "required": ["steps"],
        "not": { "anyOf": [{ "required": ["baseline"] }, { "required": ["target"] }, { "required": ["original_target"] }] }
      },
      "else": {
        "required": ["baseline", "target", "original_target"],
        "not": { "required": ["steps"] }
      }
    }
  ]
}
