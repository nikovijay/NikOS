{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nikos.tools/schemas/planning/kr.schema.json",
  "title": "nikOS Planning key result",
  "type": "object",
  "required": ["id", "title", "owner", "baseline", "target", "original_target", "by", "checkins"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "unit": { "type": "string" },
    "baseline": { "type": "number" },
    "target": { "type": "number" },
    "original_target": { "type": "number" },
    "by": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "aligns_to": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[a-z0-9]+(-[a-z0-9]+)*$" },
    "stale_after_days": { "type": "integer", "minimum": 1 },
    "checkins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "value"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "value": { "type": "number" },
          "note": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    }
  }
}
