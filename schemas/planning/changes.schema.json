{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nikos.tools/schemas/planning/changes",
  "title": "nikOS planning change file",
  "description": "The changes an editable planning export queued, for nikos apply. Operations only: no credentials and no commands. The args of downstream.add and assign can't set a url, host or ref: nikos refuses them.",
  "type": "object",
  "required": ["format", "format_version", "plan", "source", "operations"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "nikos-planning-changes" },
    "format_version": { "const": 1 },
    "plan": {
      "type": "object",
      "required": ["level", "name"],
      "additionalProperties": false,
      "properties": {
        "level": { "enum": ["company", "department", "group"] },
        "name": { "type": "string", "maxLength": 100 }
      }
    },
    "source": {
      "type": "object",
      "required": ["commit", "dirty", "exported"],
      "additionalProperties": false,
      "properties": {
        "commit": { "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{40}$" }, { "type": "null" }] },
        "dirty": { "type": "boolean" },
        "exported": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" }
      }
    },
    "made_by": { "type": "string", "maxLength": 100, "description": "Who made the changes, typed in the export. Attribution only: nothing checks it." },
    "with_linked": { "type": "boolean" },
    "operations": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/operation" } }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "required": ["op", "args"],
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "checkin",
            "kr.new",
            "kr.edit",
            "kr.target",
            "kr.align",
            "bet.new",
            "bet.edit",
            "bet.review",
            "bet.align",
            "bet.krs",
            "story.new",
            "story.rename",
            "story.move",
            "story.remove",
            "activity.new",
            "activity.rename",
            "step.new",
            "step.rename",
            "release.new",
            "release.rename",
            "release.remove",
            "release.reorder",
            "map.new",
            "assign",
            "unassign",
            "setting.set",
            "downstream.add"
          ]
        },
        "target": {
          "type": "object",
          "propertyNames": { "enum": ["kr", "bet", "story", "activity", "step", "release", "map", "team"] },
          "additionalProperties": { "type": "string" }
        },
        "args": { "type": "object", "description": "The arguments the op reads, by name. A name the op doesn't read is refused." },
        "expect": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
      }
    }
  }
}
