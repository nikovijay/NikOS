{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nikos.tools/schemas/planning/team-area.schema.json",
  "title": "nikOS Plan team: planning/teams/<KEY>/team.yaml",
  "description": "A team in a planning repo. A team has bets, never key results, and no plan.yaml.",
  "type": "object",
  "required": [
    "name",
    "home"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "home": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The department or group the team reports to."
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "members": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repos": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "The code repos the team builds in."
    }
  }
}
