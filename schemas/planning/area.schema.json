{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nikos.tools/schemas/planning/area.schema.json",
  "title": "nikOS Plan area: a plan.yaml in a planning repo",
  "description": "planning/company/plan.yaml, planning/departments/<id>/plan.yaml or planning/groups/<id>/plan.yaml. The folder says the level. Which fields each level may use is checked by nikos plan validate.",
  "type": "object",
  "required": [
    "name"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "string",
      "pattern": "^[0-9]{4}$",
      "description": "The company's year. Only the company has one: departments plan by quarter, on their key results."
    },
    "pillars": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "members": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "department": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "A group's department, if it has one."
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string"
          },
          "aligns_to": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          }
        }
      }
    }
  }
}
