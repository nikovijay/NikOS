{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nikos.tools/schemas/bet.schema.json",
  "title": "nikOS bet card front matter",
  "type": "object",
  "required": ["id", "hypothesis", "key_result", "expected_uplift", "time_box", "blockers", "stories", "status"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "hypothesis": { "type": "string", "minLength": 1 },
    "key_result": { "type": "string", "minLength": 1 },
    "expected_uplift": { "type": "string", "minLength": 1 },
    "time_box": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "stories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{0,9}-[0-9]+$" }
    },
    "status": { "enum": ["open", "won", "lost", "killed"] }
  }
}
