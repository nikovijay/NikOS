{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nikos.tools/schemas/contract/delivery.schema.json",
  "title": "nikOS delivery summary (contract reader)",
  "description": "What a planning repo reads from a map's delivery.yaml. Tolerant: unknown fields are allowed, so a newer Spec can add to the file. The writer is delivery-summary.schema.json.",
  "type": "object",
  "required": ["version", "map", "read_at", "stories"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "map": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{0,9}$" },
    "read_at": { "type": "string", "minLength": 1 },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "read_at"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*-[0-9]+$" },
          "status": { "type": "string", "minLength": 1 },
          "approval": { "enum": ["none", "approved"] },
          "approved_by": { "type": "string", "minLength": 1 },
          "proof": { "enum": ["changed", "behind", "unverified"] },
          "read_at": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
