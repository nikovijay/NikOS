{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nikos.tools/schemas/delivery-summary.schema.json",
  "title": "nikOS delivery summary",
  "type": "object",
  "required": ["format_version", "map", "read_at", "stories"],
  "additionalProperties": false,
  "properties": {
    "format_version": { "const": 1 },
    "map": { "type": "string", "minLength": 1, "maxLength": 40 },
    "owner": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{0,9}$" },
    "read_at": { "type": "string", "minLength": 1 },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "approval", "read_at"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*-[0-9]+$" },
          "status": { "type": "string", "minLength": 1 },
          "approval": { "enum": ["none", "approved"] },
          "approved_by": { "type": "string", "minLength": 1, "maxLength": 80 },
          "proof": { "enum": ["changed", "behind", "unverified"] },
          "read_at": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
