{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nikos.tools/schemas/status.schema.json",
  "title": "nikOS team status for one story",
  "type": "object",
  "required": ["status"],
  "additionalProperties": false,
  "properties": {
    "status": { "enum": ["todo", "in_progress", "needs_rework", "done", "cancelled"] },
    "claimed_by": { "type": "string" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "spec_hash": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
    "done_at": { "type": "string", "minLength": 1 },
    "cancelled_reason": { "type": "string", "minLength": 1 },
    "ticket": { "type": "string", "minLength": 1 },
    "tested_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "evidence": {
      "type": "object",
      "required": ["run_at", "runner", "commit", "ok"],
      "additionalProperties": false,
      "properties": {
        "run_at": { "type": "string", "minLength": 1 },
        "runner": { "enum": ["cucumber", "behave"] },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "ok": { "type": "boolean" }
      }
    }
  }
}
