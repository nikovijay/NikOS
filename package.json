{
  "name": "nikos",
  "version": "0.0.1",
  "description": "nikOS — an open-source agent skill stack for spec-driven development. Specs, plans and Cucumber features live in your repo.",
  "license": "MIT",
  "author": "Niko Vijay",
  "homepage": "https://nikos.tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikovijay/NikOS.git"
  },
  "type": "module",
  "bin": {
    "nikos": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "schemas",
    "templates",
    "skills",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@cucumber/gherkin": "^30.0.4",
    "@cucumber/messages": "^26.0.1",
    "ajv": "^8.17.1",
    "yaml": "^2.6.1"
  }
}
