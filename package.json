{
  "name": "nikos",
  "version": "0.0.3",
  "description": "Spec-driven development for AI coding agents: story maps, Gherkin acceptance criteria and a done gate for Claude Code, Codex and Cursor",
  "license": "MIT",
  "author": "Niko Vijay",
  "homepage": "https://nikos.tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikovijay/NikOS.git"
  },
  "type": "module",
  "bin": {
    "nikos": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "schemas",
    "templates",
    "skills",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@cucumber/gherkin": "^30.0.4",
    "@cucumber/messages": "^26.0.1",
    "ajv": "^8.17.1",
    "yaml": "^2.6.1"
  },
  "keywords": [
    "spec-driven-development",
    "ai-coding-agents",
    "agentic-coding",
    "claude-code",
    "codex",
    "cursor",
    "bdd",
    "gherkin",
    "cucumber",
    "acceptance-criteria",
    "user-story-mapping",
    "agent-skills"
  ]
}
